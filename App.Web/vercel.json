{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "https://app2-9a9d-three.vercel.app" },
      ]
    }
  ],  
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
